# =============================================================================
# Blot.ai Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit the .env file to version control.
# =============================================================================

# DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/blot
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@localhost:5432/blot

# Redis
REDIS_URL=redis://localhost:6379/0

# AUTH — Generate a strong key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# External APIs - Google Gemini
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# External APIs - Stable Horde (Image Generation)
STABLE_HORDE_API_KEY=

# Twitter / X API
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Observability (Optional)
SENTRY_DSN=
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
